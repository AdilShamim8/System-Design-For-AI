%% System Design for AI — Chapter C.1
%% Diagram: The Agent Loop (plan → act → observe → check → repeat)
%% Source: assets/diagrams/c1-agent-loop/agent-loop.mmd

graph TB
    Start([👤 User task<br/>enters the loop])
    Context[(📚 Context<br/>grows each iteration<br/>plan + actions + observations)]
    Plan[Plan<br/>LLM decides next action<br/>given full context]
    Act[Act<br/>execute the plan<br/>call tool / run code / etc.]
    Observe[Observe<br/>read the result<br/>add to context]
    Check{Termination check}
    Done([✅ Final answer<br/>returned to user])
    Budget([🛑 Stop:<br/>budget exhausted / error /<br/>max iterations / user interrupt])

    Start --> Context
    Context --> Plan
    Plan --> Act
    Act --> Observe
    Observe --> Context
    Context --> Check
    Check -->|not done| Plan
    Check -->|task complete| Done
    Check -->|budget / error| Budget

    style Plan fill:#d4edda,stroke:#155724,stroke-width:2px
    style Act fill:#fff3cd,stroke:#856404,stroke-width:2px
    style Observe fill:#cce5ff,stroke:#004085,stroke-width:2px
    style Check fill:#f8d7da,stroke:#721c24,stroke-width:2px
    style Context fill:#f8f9fa,stroke:#6c757d
